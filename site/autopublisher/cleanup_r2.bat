@echo off
chcp 65001 >nul
cd /d "%~dp0"
title Очистка мусора в R2

echo.
echo ============================================================
echo   ОЧИСТКА ФАЙЛОВ-СИРОТ В R2 (не привязаны к рассказам)
echo ============================================================
echo.
echo  Этот скрипт найдет файлы в R2, которые не привязаны
echo  ни к одному рассказу в Supabase (мусор от упавших запусков).
echo.
echo  ШАГ 1 — сначала DRY-RUN: покажет что БУДЕТ удалено, но не удалит.
echo  ШАГ 2 — если всё ок, подтвердишь — реальное удаление.
echo.
pause

echo.
echo ========== ШАГ 1: DRY-RUN (только просмотр) ==========
echo.

".venv\Scripts\python.exe" cleanup_r2_orphans.py

echo.
echo ============================================================
echo  Выше — список файлов-сирот, которые МОЖНО удалить.
echo  Файлы привязанные к рассказам в Supabase НЕ ТРОНУТЫ.
echo ============================================================
echo.
echo  ВНИМАНИЕ: удаление необратимо!
echo  Для подтверждения введи слово:  УДАЛИТЬ
echo  (просто Enter = отмена)
echo.
set /p CONFIRM=  Введи УДАЛИТЬ для подтверждения: 

if "%CONFIRM%"=="УДАЛИТЬ" goto :delete

echo.
echo  Отменено. Ничего не удалено.
goto :end

:delete
echo.
echo  Последний шанс! Ты собираешься удалить файлы из R2.
echo  Записи в Supabase останутся нетронутыми.
echo.
set /p CONFIRM2=  Введи ещё раз УДАЛИТЬ для финального подтверждения: 

if "%CONFIRM2%"=="УДАЛИТЬ" goto :delete_confirmed

echo.
echo  Отменено. Ничего не удалено.
goto :end

:delete_confirmed
echo.
echo ========== ШАГ 2: УДАЛЕНИЕ ==========
echo.

".venv\Scripts\python.exe" cleanup_r2_orphans.py --delete

echo.
echo ============================================================
echo  Готово! Мусор удалён из R2.
echo ============================================================

:end
echo.
pause
