# Content-Factory — локальные игноры (действуют только под этой папкой в монорепо).
# Исходники orchestrator/, docs/, configs/, .cursor/, tests/, tools/ — НЕ перечислять здесь как ignore.

# Виртуальные окружения
.venv-tts/
.venv/
venv/

# Выходы пайплайна и служебные деревья
output/
runs/
archive/
.orchestrator/
logs/

# Локальные веса / большие данные (дерево models/)
models/

# Python
**/__pycache__/
*.pyc
*.pyo

# Логи и lock-файлы
*.log
*.lock

# Медиа и тяжёлые артефакты
*.mp3
!orchestrator/site_tts/_silent_stub.mp3
*.wav
*.mp4
*.mov
*.avi
*.mkv
*.png
*.jpg
*.jpeg
*.webp

# Модели и чекпойнты
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.bin

# Секреты (шаблоны — см. исключения ниже; корневой .gitignore с .env* может требовать ! в корне)
.env
.env.*
**/.env
**/.env.*
secrets/
!**/.env.example
!**/.env.template

# Локальный флаг: обход зависшего ожидания mp3 на Drive (Content-Factory-Запуск.bat)
/SKIP_DRIVE_MP3_WAIT.flag

# Gemini / browser live profiles - do not commit
legacy/Gemini_Auto/user_data/
legacy/Gemini_Auto/user_data_*/

# Local browser profiles for Colab automation
.browser_profiles/
.browser_profiles/_proxy_auth_extensions/
configs/local/*.local.yaml

# Huge legacy publish archives (very long paths on Windows)
legacy/content_combiner/autopublisher/Published_Archive/
legacy/autopublisher/Published_Archive/
legacy/content_combiner/
legacy/autopublisher/

# Local scratch/test artifacts in repo root
_COLAB_EXPORTS/
_TEST_GDRIVE/
_audit/
_drive_sim/
_drive_sim2/
_e2e_input_3stories_may10/
reports/
COLAB_TTS_CURRENT/
MP3
short_under_15m
stories/
--story-id
_bat_plus_only.txt
_bat_recovered_snip.txt
START_COLAB_SMOKE_1.bat
TEST_*.bat
